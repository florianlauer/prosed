{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "prosed",
  "version": "0.2.1",
  "identifier": "com.florianlauer.prosed",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npx vite --config vite.config.ts",
    "beforeBuildCommand": "npx vite build --config vite.config.ts"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
