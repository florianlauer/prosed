{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm exec tsc --noEmit && pnpm build",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "trailingSlash": false,
  "ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- .",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "prosed-site.vercel.app"
        }
      ],
      "destination": "https://prosed.flauercase.dev/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/u/:path*",
      "destination": "https://stats.flauercase.dev/:path*"
    }
  ]
}
