{
  "name": "prosed",
  "displayName": "prosed",
  "description": "A grammar checker that runs on your machine.",
  "version": "0.11.0",
  "author": "Florian Lauer",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "chrome-extension",
    "ai",
    "grammar"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsc && vite build",
    "fmt": "prettier --write '**/*.{tsx,ts,json,css,scss,md}'",
    "zip": "npm run build && node src/zip.js",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@types/dom-chromium-ai": "^0.0.17",
    "diff": "^9.0.0",
    "ollama": "^0.6.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@tauri-apps/api": "^2.12.1",
    "@types/chrome": "^0.3.4",
    "gulp": "^5.0.1",
    "gulp-zip": "^6.1.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
